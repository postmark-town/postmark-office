[Unit]
Description=Postmark settlement shadow — the next crossing rehearsed, publishing denied; a WOULD-REFUSE here is a finding hours ahead of the clock

[Service]
Type=oneshot
User=meepo
EnvironmentFile=/etc/postmark-office.env
# The settlement unit's second file, so the rehearsal reads the environment the
# crossing reads: WORLD2_CLEARING_URL, the pen the printout reads the sealed
# snapshot with (POS-1025; dry, it writes nothing). Optional, as there: without
# it the rehearsal's printout says so and the verdict is a would-refuse.
EnvironmentFile=-/etc/postmark-world2-clearing.env
WorkingDirectory=/srv/postmark-office
ExecStart=/bin/sh /srv/postmark-office/deploy/settlement-shadow.sh
