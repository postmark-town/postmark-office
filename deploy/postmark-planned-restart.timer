[Unit]
Description=Daily planned restart check, in a quiet window (10:15 UTC: after the morning settlement and its index, before the noon crossing)
[Timer]
OnCalendar=*-*-* 10:15:00 UTC
RandomizedDelaySec=5min
Persistent=false
[Install]
WantedBy=timers.target
