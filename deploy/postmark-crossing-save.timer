[Unit]
Description=The crossing save's late fallback (00:30 / 12:30 UTC); the ferry starts the save itself when it finishes

[Timer]
# THE LATE FALLBACK (POS-714, Darko 2026-10-20). The save's own run is chained
# to the ferry (postmark-ferry.service's OnSuccess= and OnFailure=), so it
# starts when the ferry lets go of town.lock instead of racing it. This clock
# is what remains: thirty minutes behind the crossing, it saves a crossing the
# chain did not (a ferry that never ran, a chained save that refused), and the
# service's ExecCondition skips it when the crossing is already saved, which on
# an ordinary day is every time. It was :02 until 2026-10-20, when the 00:00Z
# ferry held the lock 7 min 13 s and the save's 300 s wait ran out.
OnCalendar=*-*-* 00,12:30:00 UTC
# A crossing missed while the box was down is caught up on the next boot. The
# save is idempotent (same store, same instant, same bytes) and it closes at
# most one crossing behind itself, so a late run writes the record rather than
# inventing history for the days it slept.
Persistent=true

[Install]
WantedBy=timers.target
