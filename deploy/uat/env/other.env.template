# The UAT box's other env files — NAMES ONLY (CORE-160). Each goes to the path in its heading, root:root 0600.
# Names read from prod's files on 2026-11-23 (never values). Marks as in office.env.template.

# ── /etc/postmark-world2-dev.env ── the store scripts' credential file (deploy/world2-lib.sh reads this path;
#    its name is historical). store-restore-scrub.sh reads the role passwords from here and REFUSES unless
#    WORLD2_DB is world2_uat (the scripts' default is world2_dev, prod's name).
WORLD2_DB=world2_uat                    # UAT, and the guard
PG_WORLD2_OWNER_PASSWORD=               # UAT
PG_OFFICE_API_PASSWORD=                 # UAT
PG_LAW_INGESTER_PASSWORD=               # UAT
PG_SNAPSHOT_READER_PASSWORD=            # UAT
PG_CLEARING_JOB_PASSWORD=               # UAT (new name: on prod this role's password lives only in the clearing URL below)
PG_STANCE_READER_PASSWORD=              # UAT (new name: on prod it lives only in WORLD2_STANCE_URL)
W2_S3_BUCKET=postmark-world2-backups    # the bucket prod's backup ships to (DEPLOY.md § The S3 route). UAT READS it with
                                        # its own key (the file below), list and read only; never the backup role.

# ── /etc/postmark-uat-aws.env ── root:root 0600. UAT's own AWS key (Darko, 2026-11-23 09:27 EST: an IAM user that
#    may only list and read the backup bucket). store-restore-scrub.sh sources it into one subshell and refuses it unless
#    it is root:600. Fill the secret from Darko's vault file without printing it, e.g.
#      sudo sh -c 'umask 077; { echo AWS_ACCESS_KEY_ID=<id>; printf "AWS_SECRET_ACCESS_KEY=%s
" "$(cat <vault file>)"; echo AWS_DEFAULT_REGION=us-east-2; } > /etc/postmark-uat-aws.env'
AWS_ACCESS_KEY_ID=                      # UAT
AWS_SECRET_ACCESS_KEY=                  # UAT
AWS_DEFAULT_REGION=us-east-2            # the bucket's region

# ── /etc/cloudflared/uat.env ── written by tunnel.sh from Darko's token file, never by hand (TUNNEL_TOKEN=…).

# ── /etc/postmark-world2-clearing.env ──
WORLD2_CLEARING_URL=postgres://clearing_job:<UAT password>@localhost:5432/world2_uat   # UAT
TOWN_STANCE_CUTOVER=                    # SAME

# ── /etc/postmark-site-refresh.env ──
PUBLIC_PAYPAL_CLIENT_ID=                # CHECK: prod's is a live PayPal client; UAT uses PayPal's sandbox client or none

# ── /etc/postmark-sentinel.env ── (the sentinel timer is left off: README § Open)
SENTINEL_DISCORD_WEBHOOK=               # UAT's own channel, or none; never prod's

# ── Never on UAT: /etc/postmark-bsky.env, /etc/postmark-paypal-watch.env, /etc/postmark-stripe-watch.env,
#    /etc/postmark-usdc-watch.env (their units are masked by units.sh), /etc/postmark-office-dev.env and
#    /etc/postmark-dev-rehearsal.env (dev's).
