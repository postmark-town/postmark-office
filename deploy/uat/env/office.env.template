# /etc/postmark-office.env on the UAT box — NAMES ONLY (CORE-160). Copy to /etc/postmark-office.env, root:root 0600,
# and fill the values. Never copy prod's file: every credential here is UAT's own (Darko's steps, README § Darko).
#
# The names are prod's, read from prod's /etc/postmark-office.env on 2026-11-23 (names only, never values).
# Each is marked:
#   SAME   the same value as prod (a path, a switch, a public id): copy it from DEPLOY.md, not from prod's file
#   UAT    UAT's own value, never prod's (a credential, an address, a key)
#   EMPTY  set empty or leave out: UAT must not have it
#   CHECK  not settled by this kit; a person decides before the first boot

# ── the town and world clones (stubs.sh made them; their origin is /srv/uat-stubs) ──
TOWN_CLONE=/srv/postmark-office/town-clone              # SAME path
TOWN_PUSH=                                              # CHECK: prod pushes the town with this; on UAT the clone's origin is the stub, so a push lands there. Confirm the office reads no GitHub URL from it.
TOWN_TZ=                                                # SAME
BOT_NAME=                                               # SAME
BOT_EMAIL=                                              # SAME
POSTMARK_TOWN_REPO=                                     # CHECK: names the GitHub repo for links and API reads; a read is fine, a write must not happen
WORLD_CLONE=/srv/postmark-office/world-clone            # SAME path

# ── the door ──
PUBLIC_BASE=https://uat.postmark.town                   # UAT
PRINCIPAL_GH_ID=                                        # SAME (Darko's GitHub id is public; he is UAT's principal too)
POSTMARK_OAUTH_GITHUB_CLIENT_ID=                        # UAT: the GitHub OAuth app made for uat.postmark.town (Darko's step)
POSTMARK_OAUTH_GITHUB_CLIENT_SECRET=                    # UAT: same app
POSTMARK_HUMAN_TOKENS=                                  # CHECK: prod's human tokens must not be copied; UAT's own, or empty
POSTMARK_HUMAN_NAMES=                                   # CHECK: goes with the line above

# ── credentials that reach the outside: none of prod's, ever ──
POSTMARK_PEN_TOKEN=                                     # EMPTY: a GitHub pen; UAT writes only to its stubs
GH_TOKEN=                                               # EMPTY: UAT holds no GitHub token (its remotes are local)
WITNESS_KEY=                                            # UAT: a witness key of its own (Darko's step), so a UAT signature is never prod's
WITNESS_OWED=                                           # SAME
CREATURE_SEED_KEY=                                      # UAT: its own
TYPESAFE_API_KEY=                                       # CHECK: a paid third-party API; UAT's own key or empty
R2_ACCOUNT_ID=                                          # UAT or EMPTY: uploads go to a UAT bucket, or are refused; never prod's media
R2_ACCESS_KEY_ID=                                       # UAT or EMPTY
R2_SECRET_ACCESS_KEY=                                   # UAT or EMPTY
R2_BUCKET=                                              # UAT or EMPTY

# ── the store: UAT's own copy, by UAT's own passwords ──
WORLD2_PG=1                                             # SAME
WORLD2_PG_URL=postgres://office_api:<UAT password>@localhost:5432/world2_uat    # UAT (the db name is world2_uat, never world2_dev)
WORLD2_STANCE_URL=postgres://stance_reader:<UAT password>@localhost:5432/world2_uat   # UAT
WORLD2_CANDLE=                                          # SAME
W2_PEN=                                                 # SAME
W2_GUARDS=                                              # SAME
W2_EARPIECE=                                            # EMPTY: the earpiece is masked on UAT (it wakes real residents)
OFFICE_PAPERWORK_STORE=1                                # SAME

# ── switches, read shapes and pools: as prod, so UAT tests what ships ──
WORLD_STORE_SHADOW=                                     # SAME
WORLD_EMISSIONS=                                        # SAME
WORLD_PRESENCE=                                         # SAME
WORLD_APEX=                                             # SAME
WORLD_MOVEMENT_V2=                                      # SAME
LEDGER_FREEZE=                                          # SAME
WORLD_POOL_SIZE=                                        # SAME
TOWN_SINGLE_LOG=                                        # SAME
WORLD_SINGLE_LOG=                                       # SAME
WORLD_POSITIONS=                                        # SAME
OFFICE_READ_WORKERS=                                    # SAME
STATE_LOG_SOURCE=                                       # SAME
TOWN_INDEX_READS=                                       # SAME
TOWN_STANCE_CUTOVER=                                    # SAME
WORLD_READ_SHAPE=                                       # SAME
HOUSEHOLD_READ_SHAPE=                                   # SAME
EVENT_DRAFTS_FROM=                                      # SAME
