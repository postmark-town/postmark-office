[Unit]
Description=World 2.0 notary, nightly at 07:20 UTC — after the morning crossing has published, so the certification reads the docket the crossing just cleared

[Timer]
# 07:20 UTC (moved from 03:20, office#83, 2026-09-17): the morning crossing
# publishes at 05:45Z today and 06:00Z from the w39 ship (postmark#2801), and
# its settlement receipt lands by ~06:15Z. At 03:20 the notary read every
# docketed mark as canon-absent and every founding return as escrow-unbacked,
# and the 05:45 crossing cleared the whole list before anyone read the alarm —
# a line true at 03:20 and false at 05:46 every day. 07:20 is after the receipt
# and well before the 17:45/18:00 crossing, so a certification never races a
# clearing for the same window.
OnCalendar=*-*-* 07:20:00 UTC
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
