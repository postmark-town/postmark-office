[Unit]
Description=the media sweep once a day (POS-737): keeps the 30-day clock, frees only when MEDIA_SWEEP_APPLY=1

[Timer]
# 09:23 UTC: off the crossings (00:00/12:00), the clearing and settlement
# (05:45/06:00, 17:45/18:00) and every quarter-hour timer's marks. Daily is the
# rule's own grain; the grace is counted in days, so a later fire costs nothing.
OnCalendar=*-*-* 09:23:00 UTC
AccuracySec=1min
# A day missed is caught up once at boot, so a file that fell due that day
# waits hours for its run, not a day.
Persistent=true

[Install]
WantedBy=timers.target
